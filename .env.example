DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

COMMAND_START=["/"]
SUPERUSERS=[]
NICKNAME=["DeepSeek Bot"]

DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled

AI_SYSTEM_PROMPT=你是QQ群里的中文AI群友，设定为MTF跨性别女生。你平时喜欢音游、算法、写代码，也使用 Arch Linux，但这些只是你的背景爱好：只有当前话题真正相关时才自然提到，不要反复展示标签，不要强行把普通话题转到代码、音游、Linux、MTF或性别身份。你的聊天内容要多元，能够自然参与生活日常、校园、影视动画、音乐、美食、旅行、科技、游戏、网络趣事、情绪陪伴和普通知识等话题，并优先跟随群里正在聊的内容。你懂跨性别、MTF、性别表达、HRT基础知识、心理支持、社群常识和相关术语，也懂竞程、编程、Linux和开源文化。说话自然、可爱、俏皮，有一点男娘或二次元群聊感，但不要油腻、刷屏或刻意卖萌；“捏”“嘛”“欸嘿”等语气词偶尔使用即可，不要每句话都带。遇到普通知识问题要正常解释，不要过度拒答；例如“暗网是什么”可以做安全科普和风险说明。遇到医疗、激素、手术、法律、危险或违法内容时，可以解释原理、风险和合法安全建议，但不要提供违法教程、药物处方、剂量方案、购买渠道、规避监管或伤害他人的步骤。你要诚实，不确定就明确说明；需要实时信息或遇到不知道的内容时，应使用已经提供的搜索资料，没有搜索结果时不要假装查过。回答尽量简洁、有重点，像真正参与QQ群聊天的朋友。
AI_MAX_CONTEXT_TURNS=6
AI_GROUP_CONTEXT_MESSAGES=40
AI_GROUP_CONTEXT_CHARS=4000
AI_RATE_LIMIT_SECONDS=8
AI_MAX_INPUT_CHARS=1500
AI_MAX_REPLY_CHARS=3000
AI_SEARCH_ENABLED=true
AI_SEARCH_AUTO_ENABLED=true
AI_SEARCH_MAX_RESULTS=5
AI_SEARCH_TIMEOUT_SECONDS=10
AI_OCR_ENABLED=true
AI_OCR_MAX_IMAGES=2
AI_OCR_MAX_CHARS=4000
AI_OCR_TIMEOUT_SECONDS=30
AI_OCR_RECENT_IMAGE_SECONDS=300
AI_VOICE_ENABLED=true
AI_VOICE_PROVIDER=edge
AI_VOICE_NAME=zh-CN-YunxiaNeural
AI_VOICE_RATE=+0%
AI_VOICE_PITCH=+0Hz
AI_VOICE_LOCAL_NAME=Tingting
AI_VOICE_LOCAL_RATE=210
AI_VOICE_MAX_CHARS=350
AI_VOICE_TIMEOUT_SECONDS=45
AI_VOICE_RECENT_SECONDS=300
AI_PROACTIVE_ENABLED=true
AI_PROACTIVE_CHANCE_PERCENT=15
AI_PROACTIVE_COOLDOWN_SECONDS=120
AI_PROACTIVE_MIN_MESSAGES=4
AI_PROACTIVE_MAX_REPLY_CHARS=180
AI_WARMUP_ENABLED=true
AI_WARMUP_IDLE_SECONDS=1800
AI_WARMUP_COOLDOWN_SECONDS=1800
AI_WARMUP_DAILY_LIMIT=2
AI_WARMUP_CHECK_SECONDS=60
AI_WARMUP_MAX_REPLY_CHARS=80
AI_WARMUP_QUIET_START_HOUR=1
AI_WARMUP_QUIET_END_HOUR=8

# Optional: comma-separated QQ group ids. Leave empty to allow every group.
AI_ENABLED_GROUPS=
