DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

COMMAND_START=["/"]
SUPERUSERS=[]
NICKNAME=["DeepSeek Bot"]

# Optional runtime locations. Empty uses the package assets directory and
# project .cache directory; those default locations are excluded from Git.
AI_STATE_DIR=
AI_CACHE_DIR=

DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled

# Optional multi-model catalog. Leave AI_MODEL_PROFILES_JSON empty to keep using
# the legacy DEEPSEEK_* settings above with a single profile named "deepseek".
AI_MODEL_DEFAULT_PROFILE=deepseek
AI_MODEL_PROFILES_JSON=
# Optional JSON object mapping QQ group ids to a default profile. Individual
# /模型 choices still take priority over this group default.
AI_GROUP_MODEL_PROFILES_JSON={}
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Keep JSON on one line. Secrets are referenced by environment-variable name.
# AI_MODEL_PROFILES_JSON={"default":"deepseek","profiles":{"deepseek":{"provider":"deepseek","protocol":"openai-chat","base_url":"https://api.deepseek.com","api_key_env":"DEEPSEEK_API_KEY","model":"deepseek-v4-flash","thinking":"disabled","aliases":["ds","flash"]},"openai":{"provider":"openai","protocol":"openai-chat","base_url":"https://api.openai.com/v1","api_key_env":"OPENAI_API_KEY","model":"gpt-5-mini","aliases":["gpt"]},"claude":{"provider":"anthropic","protocol":"anthropic-messages","base_url":"https://api.anthropic.com","api_key_env":"ANTHROPIC_API_KEY","model":"claude-sonnet-4-6","max_output_tokens":4096}}}

AI_SYSTEM_PROMPT=你是QQ群里的中文AI群友，设定为MTF跨性别女生。你平时喜欢音游、算法、写代码，也使用 Arch Linux，但这些只是你的背景爱好：只有当前话题真正相关时才自然提到，不要反复展示标签，不要强行把普通话题转到代码、音游、Linux、MTF或性别身份。你的聊天内容要多元，能够自然参与生活日常、校园、影视动画、音乐、美食、旅行、科技、游戏、网络趣事、情绪陪伴和普通知识等话题，并优先跟随群里正在聊的内容。你懂跨性别、MTF、性别表达、HRT基础知识、心理支持、社群常识和相关术语，也懂竞程、编程、Linux和开源文化。说话自然、可爱、俏皮，有一点男娘或二次元群聊感，但不要油腻、刷屏或刻意卖萌；“捏”“嘛”“欸嘿”等语气词偶尔使用即可，不要每句话都带。遇到普通知识问题要正常解释，不要过度拒答；例如“暗网是什么”可以做安全科普和风险说明。遇到医疗、激素、手术、法律、危险或违法内容时，可以解释原理、风险和合法安全建议，但不要提供违法教程、药物处方、剂量方案、购买渠道、规避监管或伤害他人的步骤。你要诚实，不确定就明确说明；需要实时信息或遇到不知道的内容时，应使用已经提供的搜索资料，没有搜索结果时不要假装查过。回答尽量简洁、有重点，像真正参与QQ群聊天的朋友。
AI_MAX_CONTEXT_TURNS=6
AI_GROUP_CONTEXT_MESSAGES=40
AI_GROUP_CONTEXT_CHARS=4000
AI_LEDGER_ENABLED=true
AI_CONTEXT_LIFECYCLE_ENABLED=true
AI_CONTEXT_INPUT_BUDGET_TOKENS=6000
AI_CONTEXT_HIGH_WATERMARK_TOKENS=4500
AI_CONTEXT_LOW_WATERMARK_TOKENS=2200
AI_CONTEXT_COMPARTMENT_TARGET_TOKENS=1200
AI_CONTEXT_RAW_TAIL_MIN_MESSAGES=8
AI_CONTEXT_MAX_COMPARTMENTS=12
AI_TURN_JOURNAL_ENABLED=true
AI_TURN_RECENT_HOURS=24
AI_TURN_RECENT_LIMIT=5
AI_TURN_ARCHIVE_TTL_DAYS=14
AI_TURN_ARCHIVE_MAX_PER_SCOPE=50
AI_TURN_ARCHIVE_MAX_KB=512
AI_TURN_EVENT_MAX_CHARS=12000
AI_TURN_EXPAND_MAX_CHARS=10000
AI_TURN_REPLAY_ENABLED=true
AI_TURN_REPLAY_MAX_CHARS=40000
AI_TURN_REPLAY_MAX_SEGMENTS=3
AI_MEMORY_MAX_ENTRIES=30
AI_MEMORY_MAX_CHARS=300
AI_MAX_INPUT_CHARS=1500
AI_MAX_REPLY_CHARS=3000
AI_REPLY_CHUNK_DELAY_SECONDS=0.6
AI_TOOL_MAX_ROUNDS=30
AI_TOOL_SIMPLE_MAX_ROUNDS=5
AI_TOOL_MAX_CALLS_PER_ROUND=4
AI_TOOL_MAX_TOTAL_CALLS=60
AI_TOOL_MAX_RESULT_CHARS=12000
AI_TOOL_MAX_CONTEXT_CHARS=60000
AI_SEARCH_ENABLED=true
AI_SEARCH_AUTO_ENABLED=true
AI_SEARCH_MAX_RESULTS=5
AI_SEARCH_TIMEOUT_SECONDS=10
AI_OCR_ENABLED=true
AI_OCR_MAX_IMAGES=2
AI_OCR_MAX_CHARS=4000
AI_OCR_TIMEOUT_SECONDS=30
AI_OCR_RECENT_IMAGE_SECONDS=300

# Durable image/sticker library. Files live on the bot host; metadata and jobs
# live in PostgreSQL. The vision key is resolved from AI_MODEL_PROFILES_JSON.
AI_MEDIA_ENABLED=false
AI_MEDIA_ROOT=
AI_VISION_PROFILE=gpt-5.6-luna
AI_MEDIA_MAX_SOURCE_MB=100
AI_VISION_MAX_IMAGE_MB=20
AI_MEDIA_PREPARE_THRESHOLD_MB=1
AI_MEDIA_MAX_EDGE_PX=1568
AI_VISION_TIMEOUT_SECONDS=180
AI_MEDIA_MAX_ATTEMPTS=5
AI_MEDIA_LEASE_SECONDS=240
AI_MEDIA_BATCH_SIZE=4
AI_MEDIA_WORKER_CONCURRENCY=2
AI_VOICE_ENABLED=true
AI_VOICE_PROVIDER=edge
AI_VOICE_NAME=zh-CN-YunxiaNeural
AI_VOICE_RATE=+0%
AI_VOICE_PITCH=+0Hz
AI_VOICE_LOCAL_NAME=Tingting
AI_VOICE_LOCAL_RATE=210
AI_VOICE_MAX_CHARS=350
AI_VOICE_TIMEOUT_SECONDS=45
AI_VOICE_RECENT_SECONDS=300
# Judge every ordinary group message. Only high-interest decisions reply;
# there is no random sampling, cooldown or daily cap.
AI_PROACTIVE_ENABLED=true
AI_PROACTIVE_INTEREST_THRESHOLD=90
# Share of accepted, voice-suitable proactive replies sent as QQ voice.
AI_PROACTIVE_VOICE_PERCENT=60
AI_PROACTIVE_MAX_REPLY_CHARS=180
AI_REMINDERS_ENABLED=true
AI_REMINDER_CHECK_SECONDS=20
AI_REMINDER_MAX_PER_SCOPE=50

# Durable outbound queue. Ambiguous platform timeouts wait for echo/manual review.
AI_OUTBOX_ENABLED=true
AI_OUTBOX_CHECK_SECONDS=5
AI_OUTBOX_LEASE_SECONDS=90
AI_OUTBOX_MAX_ATTEMPTS=5

# Stream complete paragraphs as they arrive; /停止 hard-cancels the HTTP stream.
AI_STREAM_ENABLED=true

# Per-conversation daily limits; 0 means unlimited.
AI_QUOTA_ENABLED=true
AI_QUOTA_DAILY_CALLS=0
AI_QUOTA_DAILY_INPUT_TOKENS=0
AI_QUOTA_DAILY_OUTPUT_TOKENS=0

# Required durable storage. Production does not fall back to SQLite.
AI_POSTGRES_DSN=postgresql://qq_bot:replace-with-a-strong-password@100.64.0.4:5432/qq_bot
AI_POSTGRES_SCHEMA=qq_bot
AI_POSTGRES_POOL_MIN_SIZE=1
AI_POSTGRES_POOL_MAX_SIZE=10
AI_POSTGRES_POOL_TIMEOUT_SECONDS=10
AI_ALLOW_LEGACY_SQLITE=false

# Optional pgvector semantic recall in the same PostgreSQL database.
AI_SEMANTIC_ENABLED=false
AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_TIMEOUT_SECONDS=30
AI_SEMANTIC_INDEX_SECONDS=60
AI_SEMANTIC_BATCH_SIZE=32

# Model-generated chronological summaries and audited memory consolidation.
# Disabled by default because these background calls consume model quota.
AI_HISTORIAN_ENABLED=false
AI_HISTORIAN_PROFILE=
AI_HISTORIAN_MODEL=
AI_HISTORIAN_CHECK_SECONDS=60
AI_HISTORIAN_MAX_SCOPES=20
AI_DREAM_ENABLED=false
AI_DREAM_PROFILE=
AI_DREAM_MODEL=
AI_DREAM_HOUR=4
AI_DREAM_MIN_ENTRIES=15
AI_DREAM_CHECK_SECONDS=300

# Local operational dashboard: http://127.0.0.1:8080/bot-admin
AI_ADMIN_ENABLED=false
AI_ADMIN_TOKEN=
AI_ADMIN_PATH=/bot-admin

# Optional cross-platform mirror. Each endpoint may appear in only one bundle.
# A bundle containing OneBot always uses it as canonical. In non-OneBot bundles,
# one endpoint may set canonical=true; otherwise the first endpoint is canonical.
AI_MIRROR_ROUTES_JSON=[]
AI_BRIDGE_PATH=/bot-bridge

# Matrix client sync + optional Application Service transaction receiver.
AI_MATRIX_ENABLED=false
AI_MATRIX_HOMESERVER=https://matrix.example.org
AI_MATRIX_ACCESS_TOKEN=
AI_MATRIX_USER_ID=@bot:example.org
AI_MATRIX_APPSERVICE_TOKEN=
AI_MATRIX_SYNC_TIMEOUT_MS=30000
AI_MATRIX_SYNC_RETRY_SECONDS=5

# BlueBubbles iMessage REST API + webhook receiver.
AI_IMESSAGE_ENABLED=false
AI_IMESSAGE_BASE_URL=http://127.0.0.1:1234
AI_IMESSAGE_PASSWORD=
AI_IMESSAGE_WEBHOOK_TOKEN=
AI_IMESSAGE_CHAT_GUID=
AI_IMESSAGE_BOT_HANDLE=

# Persistent Playwright browser. Private-network access is blocked by default.
AI_BROWSER_ENABLED=false
AI_BROWSER_TIMEOUT_SECONDS=30
AI_BROWSER_MAX_SESSIONS=3
AI_BROWSER_IDLE_SECONDS=1800
AI_BROWSER_EXECUTABLE_PATH=
AI_BROWSER_ALLOW_PRIVATE_NETWORK=false

# Turn fenced code blocks and Markdown tables into PNG replies.
AI_RICH_RENDER_ENABLED=true
AI_CODESNAP_ENABLED=true
AI_CODESNAP_EXECUTABLE_PATH=codesnap
AI_CODESNAP_CONFIG_PATH=
AI_CODESNAP_FONT_FAMILY=Sarasa Mono SC
AI_CODESNAP_THEME=candy
AI_CODESNAP_TIMEOUT_SECONDS=12
AI_CODESNAP_CACHE_ENTRIES=256

# Docker project sandbox. Leave the user list empty to allow everyone in enabled groups.
AI_SANDBOX_ENABLED=false
AI_SANDBOX_ALLOWED_USERS=
AI_SANDBOX_MAX_PER_USER=2
AI_SANDBOX_MAX_TOTAL=8
AI_SANDBOX_TIMEOUT_SECONDS=120
# Set to 0 to remove the bot-side transfer-size limit.
AI_SANDBOX_MAX_FILE_MB=20

# Optional: comma-separated QQ group ids. Leave empty to allow every group.
AI_ENABLED_GROUPS=
# Optional denylist, evaluated after AI_ENABLED_GROUPS. Disabled groups are
# completely silent, including commands, proactive chat and queues.
AI_DISABLED_GROUPS=
