+use maxops_proto::{WorkspaceCreateParams, WorkspaceRecord, WorkspaceState};
+use serde_json::json;
+
+#[test]
+fn immutable_workspace_commit_preserves_source_and_rejects_dirty_state() {
+    let mut workspace: WorkspaceRecord = serde_json::from_value(json!({
+        "workspace_id": "019d0000-0000-7000-8000-000000000001",
+        "repository": "fixture", "executor": "alpha", "base_commit": "a".repeat(40),
+        "revision": 1, "tree_hash": "b".repeat(40), "state": "clean",
+        "creator": "manager", "created_at": "2026-09-07T00:00:00Z"
+    }))
+    .unwrap();
+    assert_eq!(
+        workspace.deployment_commit(),
+        Some(workspace.base_commit.as_str())
+    );
+    workspace.revision = 2;
+    assert!(workspace.deployment_commit().is_none());
+    workspace.commit_hash = Some("c".repeat(40));
+    for state in [WorkspaceState::Clean, WorkspaceState::Dirty] {
+        workspace.state = state;
+        assert!(workspace.deployment_commit().is_none());
+    }
+    for state in [WorkspaceState::Committed, WorkspaceState::Published] {
+        workspace.state = state;
+        assert_eq!(
+            workspace.deployment_commit(),
+            workspace.commit_hash.as_deref()
+        );
+    }
+    workspace.commit_hash = None;
+    assert!(workspace.deployment_commit().is_none());
+}
+
+#[test]
+fn exact_workspace_request_requires_checked_head_and_full_object_id() {
+    let legacy: WorkspaceCreateParams =
+        serde_json::from_value(json!({"repository":"fixture"})).unwrap();
+    assert!(legacy.validate().is_ok());
+    for source in ["a".repeat(40), "b".repeat(64)] {
+        let mut params: WorkspaceCreateParams = serde_json::from_value(json!({
+            "repository":"fixture", "source_commit":source, "expected_remote_head":"c".repeat(40)
+        }))
+        .unwrap();
+        assert!(params.validate().is_ok());
+        params.expected_remote_head = None;
+        assert!(params.validate().is_err());
+    }
+    for source in [
+        "main",
+        "--upload-pack=sh",
+        "HEAD~1",
+        "abcdef0",
+        "../outside",
+    ] {
+        let params: WorkspaceCreateParams = serde_json::from_value(json!({
+            "repository":"fixture", "source_commit":source, "expected_remote_head":"c".repeat(40)
+        }))
+        .unwrap();
+        assert!(params.validate().is_err());
+    }
+}
