+impl WorkspaceRecord {
+    /// A freshly materialized revision already names an immutable Git commit.
+    pub fn deployment_commit(&self) -> Option<&str> {
+        let commit = match (self.state, self.commit_hash.as_deref()) {
+            (WorkspaceState::Clean, None) if self.revision == 1 => &self.base_commit,
+            (WorkspaceState::Committed | WorkspaceState::Published, Some(commit)) => commit,
+            _ => return None,
+        };
+        valid_git_oid(commit).then_some(commit)
+    }
+}
