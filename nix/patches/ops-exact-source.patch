+async fn exact_source_commit(
+    git: &Path,
+    mirror: &Path,
+    requested: Option<&str>,
+    head: &str,
+) -> Result<String> {
+    let source = requested.unwrap_or(head).to_ascii_lowercase();
+    ensure!(
+        maxops_proto::valid_git_oid(&source) && maxops_proto::valid_git_oid(head),
+        "invalid source commit"
+    );
+    let object = isolated_git_command(git, Some(mirror), None)
+        .args(["cat-file", "-t", &source])
+        .stdin(Stdio::null())
+        .stderr(Stdio::null())
+        .output()
+        .await?;
+    ensure!(
+        object.status.success() && object.stdout == b"commit\n",
+        "source is not a commit object"
+    );
+    let ancestry = isolated_git_command(git, Some(mirror), None)
+        .args(["merge-base", "--is-ancestor", &source, head])
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .status()
+        .await?;
+    ensure!(
+        ancestry.success(),
+        "source is not reachable from the checked remote head"
+    );
+    Ok(source)
+}
